# The secrets of alcyone. Copy this file and fill in the values in the copy.
# Git ignores every .env file except this one, so never write values here.
#
# For `cf dev` with an "s3" development storage, copy this file to .env and fill in
# keys for the development bucket. The "local-r2" development storage needs no keys.
# For `pnpm stack:deploy`, copy this file to .env.production and fill in keys for the
# production bucket. Git ignores .env.production, and pnpm stack:deploy uploads the
# keys to the Worker as secrets.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
