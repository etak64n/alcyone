{
  "name": "alcyone",
  "version": "0.1.0",
  "private": true,
  "description": "A whiteboard for teams that runs on Cloudflare Workers and keeps every board in an S3-compatible bucket.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^22.23.0 || ^24.22.0 || ^26.12.0"
  },
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "stack:deploy": "node stack/cli.ts deploy",
    "stack:delete": "node stack/cli.ts delete",
    "typecheck": "tsc -p tsconfig.json && tsc -p worker/tsconfig.json && tsc -p tsconfig.node.json",
    "test": "vitest run"
  },
  "dependencies": {
    "aws4fetch": "^1.0.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hono": "^4.13.16",
    "jose": "^6.2.15",
    "lucide-react": "^1.68.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.v.11",
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "cf": "1.0.0-beta.27",
    "tailwindcss": "^4.3.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
